{
  "name": "lightkeepers-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test src/lib/tierlist.test.ts src/lib/server/cache.test.ts src/lib/server/request-validation.test.ts src/lib/character-teams.test.ts src/lib/character-builds.test.ts src/lib/investment-teams.test.ts src/lib/solver.test.ts src/lib/roster-snapshot.test.ts src/lib/calculator-goals.test.ts src/lib/calculator-goals-snapshot.test.ts src/lib/upgrade-priority.test.ts src/lib/query-state.test.ts src/lib/nav-history.test.ts src/lib/utils.traveler.test.ts src/lib/traveler-kits.test.ts src/lib/crimson-witch.test.ts src/lib/patch-notes.test.ts src/lib/patch-notes-seen.test.ts src/lib/is-beta-character.test.ts src/lib/character-filter.test.ts src/lib/upgrade-costs.test.ts",
    "test": "pnpm test:unit && pnpm exec playwright test",
    "sync:schedules": "tsx scripts/workflows/sync-schedules.ts",
    "sync:character-assets": "tsx scripts/workflows/sync-character-assets.ts",
    "sync:equipment": "tsx scripts/workflows/sync-equipment.ts",
    "sync:beta-assets": "tsx scripts/workflows/sync-beta-assets.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/sveltekit": "^10.67.0",
    "@supabase/supabase-js": "^2.110.8",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3"
  }
}
