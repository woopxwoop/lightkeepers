    "@supabase/supabase-js": "^2.90.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@tailwindcss/vite": "^4.1.18",
    "better-auth": "^1.6.9",
    "dotenv": "^17.3.1",
    "enka-network-api": "^5.0.14",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "supabase": "^2.93.0",
    "tailwindcss": "^4.1.18"
  }
}
