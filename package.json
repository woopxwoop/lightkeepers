{
  "name": "lightkeepers-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update-types": "node update-types.mjs",
    "studio": "node studio.mjs",
    "worktree": "node worktree.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test \"*.test.mjs\" \"src/**/*.test.ts\"",
    "test": "pnpm test:unit && pnpm exec playwright test",
    "sync:schedules": "tsx scripts/workflows/sync-schedules.ts",
    "sync:character-assets": "tsx scripts/workflows/sync-character-assets.ts",
    "sync:equipment": "tsx scripts/workflows/sync-equipment.ts",
    "sync:beta-assets": "tsx scripts/workflows/sync-beta-assets.ts",
    "sync:stygian": "tsx scripts/workflows/sync-stygian.ts",
    "sync:abyss": "tsx scripts/workflows/sync-abyss.ts",
    "sync:patch": "tsx scripts/workflows/sync-patch.ts",
    "data:split-weapons": "node split-weapon-data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@sentry/sveltekit": "^10.76.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.12",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
