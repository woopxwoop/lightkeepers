{
  "name": "lightkeepers-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "update-types": "npx supabase gen types --lang=typescript --project-id oihiyebudfruomyzllql > ./src/lib/types/database.types.ts",
    "sync:schedules": "tsx scripts/workflows/sync-schedules.ts",
    "sync:character-assets": "tsx scripts/workflows/sync-character-assets.ts",
    "sync:equipment": "tsx scripts/workflows/sync-equipment.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/sveltekit": "^10.63.0",
    "@supabase/supabase-js": "^2.110.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tailwindcss/vite": "^4.3.2",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "sharp": "^0.34.5",
    "supabase": "^2.109.0",
    "tailwindcss": "^4.3.2"
  }
}
